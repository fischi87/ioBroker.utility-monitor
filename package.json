{
  "name": "iobroker.utility-monitor",
  "version": "1.7.0",
  "description": "Monitor gas, water, and electricity consumption with cost calculation",
  "author": {
    "name": "fischi87",
    "email": "axel.fischer@hotmail.com"
  },
  "contributors": [
    {
      "name": "Axel Fischer"
    }
  ],
  "homepage": "https://github.com/fischi87/ioBroker.utility-monitor",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "utility",
    "electricity",
    "gas",
    "water",
    "costs",
    "energy",
    "monitoring",
    "metering",
    "consumption",
    "home-automation",
    "smart-home"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fischi87/ioBroker.utility-monitor.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.1.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "main": "main.js",
  "files": [
    "admin/*.json",
    "admin/*.json5",
    "admin/*.png",
    "admin/*.svg",
    "admin/*.html",
    "admin/*.js",
    "admin/i18n/*.json",
    "lib/",
    "www/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test|admin)/**/*.test.js,*.test.js,test/**/*.test.js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/fischi87/ioBroker.utility-monitor/issues"
  },
  "readmeFilename": "README.md"
}
